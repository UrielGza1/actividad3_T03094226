# while True: el menú se repite siempre; la única salida es el break
while True:
    # Mostramos el menú
    print()
    print("===== 🍟 SNACK BAR CUTE =====")
    print("1. Ver bebidas")
    print("2. Ver papas y botanas")
    print("3. Ver horario")
    print("4. Salir")

    # Pedimos la opción
    opcion = input("Elige una opción: ")

    # Revisamos qué opción eligió
    if opcion == "1":
        print("\n--- 🥤 BEBIDAS ---")
        print("🥤 Refresco de lata ........ $30")
        print("🧋 Boba Tea de Taro ...... $80")
        print("🍋 Limonada mineral ...... $45")
        print("🍓 Frappé de Fresa ....... $70")
    elif opcion == "2":
        print("\n--- 🍟 PAPAS Y BOTANAS ---")
        print("🍟 Papas a la francesa ......... $65")
        print("🧀 Papas con queso y tocino ..... $85")
        print("🔥 Papas preparadas con salsa ... $55")
        print("🥔 Nachos con queso y jalapeño .. $70")
        print("🧅 Aros de cebolla crujientes ... $60")
    elif opcion == "3":
        print("\n--- 🕒 HORARIOS DE ATENCIÓN ---")
        print("🕒 Lunes a Viernes: 8:00 a 21:00")
        print("🕒 Sábados y Domingos: 9:00 a 18:00")
    elif opcion == "4":
        print("👋 ¡Gracias por visitarnos, Uriel! Te esperamos pronto.")
        # El cliente eligió Salir: break nos saca del while
        break
    else:
        print("❌ Opción no válida, elige del 1 al 4")